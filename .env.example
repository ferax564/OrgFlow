AUTH_MODE=dev
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787
SESSION_SECRET=change-me-to-a-long-random-string
TENANT_NAME=Organization
TENANT_SLUG=default
DATA_DIR=./data

# Production (Keycloak / AWS) — never use AUTH_MODE=dev on a public port
# AUTH_MODE=oidc
# HOST=0.0.0.0
# SECURE_COOKIES=1
# KEYCLOAK_ISSUER=https://keycloak.example.com/realms/orgflow
# KEYCLOAK_CLIENT_ID=orgflow
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=https://orgflow.example.com/auth/callback
