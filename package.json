{
  "name": "orgflow",
  "private": true,
  "version": "2.4.0-rc.2",
  "description": "Interactive organization-chart and workforce-planning app that runs entirely in the browser.",
  "author": "OrgFlow contributors",
  "license": "MIT",
  "homepage": "https://github.com/ferax564/OrgFlow",
  "main": "desktop/main.cjs",
  "desktopName": "OrgFlow.desktop",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "start:enterprise": "node server/index.js",
    "mcp": "node server/mcp-stdio.js",
    "test": "node --test tests/*.test.cjs",
    "icon": "python3 scripts/make-icon.py",
    "desktop": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac zip --universal --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "check": "node scripts/check.cjs",
    "lint": "eslint .",
    "test:browser": "python3 tests/browser-regressions.py",
    "test:desktop": "node scripts/desktop-regressions.cjs",
    "backup": "node server/backup.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "playwright": "1.57.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "openid-client": "6.8.8"
  }
}
